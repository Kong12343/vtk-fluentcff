from __future__ import annotations


class vtkFLUENTCFFReader:
    """Python binding for the local Fluent CFF VTK reader."""

    def __init__(self) -> None: ...

    def SetFileName(self, file_name: str) -> None: ...
    def GetFileName(self) -> str: ...

    def SetDataFileName(self, data_file_name: str) -> None: ...
    def GetDataFileName(self) -> str: ...

    def SetRenameArrays(self, rename_arrays: int) -> None: ...
    def GetRenameArrays(self) -> int: ...

    def SetExcludedFieldArrayNames(self, names: list[str]) -> None: ...
    def ClearExcludedFieldArrayNames(self) -> None: ...
    def GetExcludedFieldArrayNames(self) -> list[str]: ...

    def Update(self) -> None: ...
    def UpdateInformation(self) -> None: ...

    TIME_STEP_FULL_DOUBLE: int
    TIME_STEP_DELTA_FLOAT32: int

    def LoadCaseMesh(self) -> int: ...
    def LoadDataTimeStep(self, dat_path: str) -> int: ...
    def GetNumberOfLoadedTimeSteps(self) -> int: ...
    def GetFlowTime(self, time_step_index: int) -> float: ...
    def GetFluentTimeStep(self, time_step_index: int) -> int: ...
    def FindLoadedTimeStepIndexByFlowTime(self, flow_time: float, tolerance: float = 1e-9) -> int: ...
    def FindLoadedTimeStepIndexByFluentStep(self, fluent_time_step: int) -> int: ...
    def GetTimeStepStorageMode(self, time_step_index: int) -> int: ...
    def SetActiveTimeStepIndex(self, index: int) -> None: ...
    def GetActiveTimeStepIndex(self) -> int: ...
    def SetReferenceTimeStepIndex(self, index: int) -> None: ...
    def GetReferenceTimeStepIndex(self) -> int: ...
    def SetUseDeltaStorage(self, use_delta: bool) -> None: ...
    def GetUseDeltaStorage(self) -> bool: ...
    def SetEmitVtkOutput(self, emit: bool) -> None: ...
    def GetEmitVtkOutput(self) -> bool: ...
    def ReleaseDataTimeStep(self, time_step_index: int) -> None: ...
    def ReleaseAllDataTimeSteps(self) -> None: ...
    def ReleaseCaseMesh(self) -> None: ...
    def GetMeshLoaded(self) -> bool: ...

    def GetNumberOfFaceZones(self) -> int: ...
    def GetFaceZoneName(self, index: int) -> str: ...
    def GetFaceZoneIdByName(self, name: str) -> int: ...
    def GetFaceZoneType(self, zone_id: int) -> int: ...
    def GetCellZoneType(self, zone_id: int) -> int: ...
